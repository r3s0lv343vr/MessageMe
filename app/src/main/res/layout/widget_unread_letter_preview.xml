<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/unread_letter_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_unread_letter_bubble"
    android:gravity="start"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/unread_letter_sender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_unread_letter_sender"
        android:textColor="@color/letter_foam"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/unread_letter_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_unread_letter_badge"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textColor="@color/letter_foam"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/unread_letter_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="@string/widget_unread_letter_empty"
        android:textColor="@color/letter_foam"
        android:textSize="16sp" />
</LinearLayout>
